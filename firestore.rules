rules_version = '2';

// Firestore güvenlik kuralları.
// Uygulamadaki ekran gizleme sadece görünüştür; verinin asıl koruması buradadır.
// Firebase Console > Firestore Database > Rules sekmesine yapıştırılıp "Publish" edilir.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Giriş yapan kullanıcının users/{uid} dökümanı.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentRole() {
      return me().role;
    }

    function isAdmin() {
      return isSignedIn() && currentRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isSignedIn() && currentRole() in ['admin', 'manager'];
    }

    function isManager() {
      return isSignedIn() && currentRole() == 'manager';
    }

    // Profili silinmiş kullanıcıların oturumu açık kalsa bile veri okuyamaması için.
    function hasProfile() {
      return isSignedIn() && currentRole() in ['admin', 'manager', 'resident'];
    }

    // Uygulamadan atanabilecek roller. Admin rolü sadece Firebase Console'dan verilir.
    function isAssignableRole(role) {
      return role in ['manager', 'resident'];
    }

    function isValidNewUser(data) {
      return data.keys().hasOnly(['username', 'displayName', 'role', 'apartmentNo', 'createdAt'])
        && data.keys().hasAll(['username', 'displayName', 'role', 'apartmentNo'])
        && data.username is string && data.username.matches('^[a-z0-9._-]{3,30}$')
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && isAssignableRole(data.role)
        && data.apartmentNo is int && data.apartmentNo >= 1 && data.apartmentNo <= 9;
    }

    // users/{userId}: döküman kimliği = Firebase Auth uid
    // Alanlar: username, displayName, role ('admin' | 'manager' | 'resident'), apartmentNo, createdAt
    match /users/{userId} {
      // Herkes kendi profilini; admin ve yönetici tüm profilleri okuyabilir.
      allow read: if isSignedIn() && (request.auth.uid == userId || isManagerOrAdmin());

      // Sadece admin, geçerli alanlarla sakin/yönetici oluşturabilir.
      allow create: if isAdmin() && isValidNewUser(request.resource.data);

      // Sadece admin, başka bir (admin olmayan) kullanıcının rolünü değiştirebilir.
      // Kimse kendi rolünü değiştiremez; admin kendini kilitleyemez.
      allow update: if isAdmin()
        && userId != request.auth.uid
        && isAssignableRole(resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && isAssignableRole(request.resource.data.role);

      // Sadece admin, kendisi ve diğer adminler hariç kullanıcıları silebilir.
      allow delete: if isAdmin()
        && userId != request.auth.uid
        && isAssignableRole(resource.data.role);
    }

    function isValidAnnouncementContent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.body is string && data.body.size() > 0 && data.body.size() <= 2000
        && data.important is bool;
    }

    // announcements/{id}
    // Alanlar: title, body, important, authorUid, authorName, createdAt, updatedAt
    match /announcements/{announcementId} {
      // Profili olan herkes duyuruları okuyabilir.
      allow read: if hasProfile();

      // Sadece yönetici yayınlar; yazar kendisi, tarih sunucu saati olmalı.
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['title', 'body', 'important', 'authorUid', 'authorName', 'createdAt'])
        && isValidAnnouncementContent(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.createdAt == request.time;

      // Yönetici sadece içeriği düzenleyebilir; yazar ve oluşturma tarihi değişmez.
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'important', 'updatedAt'])
        && isValidAnnouncementContent(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isManager();
    }

    // duePeriods/{periodId}: aylık aidat dönemi. periodId = "2026-10"
    // Alanlar: year, month, amount, createdBy, createdAt
    match /duePeriods/{periodId} {
      allow read: if hasProfile();

      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['year', 'month', 'amount', 'createdBy', 'createdAt'])
        && request.resource.data.year is int && request.resource.data.year >= 2020 && request.resource.data.year <= 2100
        && request.resource.data.month is int && request.resource.data.month >= 1 && request.resource.data.month <= 12
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Dönem açıldıktan sonra değiştirilemez; yanlışsa silinip yeniden açılır.
      allow update: if false;
      allow delete: if isManager();
    }

    // dues/{periodId}_{apartmentNo}: bir dairenin bir aylık aidatı.
    // Alanlar: periodId, year, month, apartmentNo, amount, paid, paidAt, method
    match /dues/{dueId} {
      // Yönetici ve admin tüm daireleri; sakin sadece kendi dairesini görür.
      allow read: if isManagerOrAdmin()
        || (hasProfile() && resource.data.apartmentNo == me().apartmentNo);

      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['periodId', 'year', 'month', 'apartmentNo', 'amount', 'paid', 'paidAt', 'method'])
        && request.resource.data.apartmentNo is int
        && request.resource.data.apartmentNo >= 1 && request.resource.data.apartmentNo <= 9
        && dueId == request.resource.data.periodId + '_' + string(request.resource.data.apartmentNo)
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.paid == false
        && request.resource.data.paidAt == null
        && request.resource.data.method == null;

      // Yönetici sadece ödeme durumunu değiştirebilir.
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'paidAt', 'method'])
        && (
          (request.resource.data.paid == true
            && request.resource.data.method in ['cash', 'transfer']
            && request.resource.data.paidAt == request.time)
          || (request.resource.data.paid == false
            && request.resource.data.method == null
            && request.resource.data.paidAt == null)
        );

      allow delete: if isManager();
    }

    // polls/{pollId}: anket.
    // Alanlar: question, description, options [{id, text}], counts {id: sayı},
    //          votedApartments [daire no], closed, createdBy, authorName, createdAt
    match /polls/{pollId} {
      function pollPath() {
        return /databases/$(database)/documents/polls/$(pollId);
      }

      function myVotePath() {
        return /databases/$(database)/documents/polls/$(pollId)/votes/$(string(me().apartmentNo));
      }

      // Bir dairenin oy verirken anketi güncellemesi: sadece kendi seçtiği seçeneğin sayacı 1 artar
      // ve daire numarası katılımcılara eklenir. Oy kaydı aynı işlemde yazılmış olmalı.
      function isValidVoteUpdate() {
        let apt = me().apartmentNo;
        let opt = getAfter(myVotePath()).data.optionId;
        return hasProfile()
          && apt is int
          && resource.data.closed == false
          && !(apt in resource.data.votedApartments)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'votedApartments'])
          && request.resource.data.votedApartments == resource.data.votedApartments.concat([apt])
          && opt in resource.data.counts
          && request.resource.data.counts.diff(resource.data.counts).affectedKeys().hasOnly([opt])
          && request.resource.data.counts[opt] == resource.data.counts[opt] + 1;
      }

      allow read: if hasProfile();

      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['question', 'description', 'options', 'counts', 'votedApartments', 'closed', 'createdBy', 'authorName', 'createdAt'])
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0 && request.resource.data.question.size() <= 150
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.options is list
        && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 5
        && request.resource.data.counts is map
        && request.resource.data.counts.size() == request.resource.data.options.size()
        && request.resource.data.votedApartments == []
        && request.resource.data.closed == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Yönetici oylamayı kapatıp açabilir; daireler sadece oy verirken sayacı günceller.
      allow update: if (isManager()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed'])
          && request.resource.data.closed is bool)
        || isValidVoteUpdate();

      allow delete: if isManager();

      // polls/{pollId}/votes/{apartmentNo}: bir dairenin oyu. Gizlidir.
      match /votes/{voteId} {
        // Yönetici tüm oyları; daire sadece kendi oyunu okuyabilir.
        allow read: if isManagerOrAdmin()
          || (hasProfile() && me().apartmentNo is int && voteId == string(me().apartmentNo));

        // Her daire tek oy: kayıt kimliği daire numarasıdır, sonradan değiştirilemez.
        allow create: if hasProfile()
          && me().apartmentNo is int
          && voteId == string(me().apartmentNo)
          && request.resource.data.keys().hasOnly(['apartmentNo', 'optionId', 'voterUid', 'createdAt'])
          && request.resource.data.apartmentNo == me().apartmentNo
          && request.resource.data.voterUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && get(pollPath()).data.closed == false
          && !(me().apartmentNo in get(pollPath()).data.votedApartments)
          && request.resource.data.optionId in get(pollPath()).data.counts
          && me().apartmentNo in getAfter(pollPath()).data.votedApartments;

        allow update: if false;
        allow delete: if isManager();
      }
    }

    // issues/{id}: sakinin bildirdiği arıza veya istek. Şeffaflık için tüm sakinlere açıktır.
    // Alanlar: title, description, category, location, status, apartmentNo, reporterUid,
    //          reporterName, managerNote, createdAt, updatedAt, resolvedAt
    match /issues/{issueId} {
      allow read: if hasProfile();

      // Dairesi olan herkes kendi adına "açık" talep oluşturabilir.
      allow create: if hasProfile()
        && me().apartmentNo is int
        && request.resource.data.keys().hasOnly(['title', 'description', 'category', 'location', 'status', 'apartmentNo', 'reporterUid', 'reporterName', 'managerNote', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000
        && request.resource.data.location is string && request.resource.data.location.size() <= 100
        && request.resource.data.category in ['elevator', 'lighting', 'plumbing', 'heating', 'cleaning', 'common_area', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.apartmentNo == me().apartmentNo
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.managerNote == ''
        && request.resource.data.createdAt == request.time;

      // Sadece yönetici durumu ve notu günceller; talebin içeriği değiştirilemez.
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'managerNote', 'updatedAt', 'resolvedAt'])
        && request.resource.data.status in ['open', 'in_progress', 'resolved']
        && request.resource.data.managerNote is string && request.resource.data.managerNote.size() <= 500
        && request.resource.data.updatedAt == request.time;

      // Yönetici her talebi; bildiren kişi kendi talebini henüz "açık" iken silebilir.
      allow delete: if isManager()
        || (hasProfile() && resource.data.reporterUid == request.auth.uid && resource.data.status == 'open');
    }

    // Listede olmayan her şey varsayılan olarak kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
