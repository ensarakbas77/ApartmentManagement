rules_version = '2';

// Firestore güvenlik kuralları.
// Uygulamadaki ekran gizleme sadece görünüştür; verinin asıl koruması buradadır.
// Firebase Console > Firestore Database > Rules sekmesine yapıştırılıp "Publish" edilir.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && currentRole() == 'admin';
    }

    function isManagerOrAdmin() {
      return isSignedIn() && currentRole() in ['admin', 'manager'];
    }

    function isManager() {
      return isSignedIn() && currentRole() == 'manager';
    }

    // Profili silinmiş kullanıcıların oturumu açık kalsa bile veri okuyamaması için.
    function hasProfile() {
      return isSignedIn() && currentRole() in ['admin', 'manager', 'resident'];
    }

    // Uygulamadan atanabilecek roller. Admin rolü sadece Firebase Console'dan verilir.
    function isAssignableRole(role) {
      return role in ['manager', 'resident'];
    }

    function isValidNewUser(data) {
      return data.keys().hasOnly(['username', 'displayName', 'role', 'apartmentNo', 'createdAt'])
        && data.keys().hasAll(['username', 'displayName', 'role', 'apartmentNo'])
        && data.username is string && data.username.matches('^[a-z0-9._-]{3,30}$')
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60
        && isAssignableRole(data.role)
        && data.apartmentNo is int && data.apartmentNo >= 1 && data.apartmentNo <= 9;
    }

    // users/{userId}: döküman kimliği = Firebase Auth uid
    // Alanlar: username, displayName, role ('admin' | 'manager' | 'resident'), apartmentNo, createdAt
    match /users/{userId} {
      // Herkes kendi profilini; admin ve yönetici tüm profilleri okuyabilir.
      allow read: if isSignedIn() && (request.auth.uid == userId || isManagerOrAdmin());

      // Sadece admin, geçerli alanlarla sakin/yönetici oluşturabilir.
      allow create: if isAdmin() && isValidNewUser(request.resource.data);

      // Sadece admin, başka bir (admin olmayan) kullanıcının rolünü değiştirebilir.
      // Kimse kendi rolünü değiştiremez; admin kendini kilitleyemez.
      allow update: if isAdmin()
        && userId != request.auth.uid
        && isAssignableRole(resource.data.role)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && isAssignableRole(request.resource.data.role);

      // Sadece admin, kendisi ve diğer adminler hariç kullanıcıları silebilir.
      allow delete: if isAdmin()
        && userId != request.auth.uid
        && isAssignableRole(resource.data.role);
    }

    function isValidAnnouncementContent(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.body is string && data.body.size() > 0 && data.body.size() <= 2000
        && data.important is bool;
    }

    // announcements/{id}
    // Alanlar: title, body, important, authorUid, authorName, createdAt, updatedAt
    match /announcements/{announcementId} {
      // Profili olan herkes duyuruları okuyabilir.
      allow read: if hasProfile();

      // Sadece yönetici yayınlar; yazar kendisi, tarih sunucu saati olmalı.
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['title', 'body', 'important', 'authorUid', 'authorName', 'createdAt'])
        && isValidAnnouncementContent(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.createdAt == request.time;

      // Yönetici sadece içeriği düzenleyebilir; yazar ve oluşturma tarihi değişmez.
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'important', 'updatedAt'])
        && isValidAnnouncementContent(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isManager();
    }

    // Listede olmayan her şey varsayılan olarak kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
